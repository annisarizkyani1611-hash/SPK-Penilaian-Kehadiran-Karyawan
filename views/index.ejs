<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Sistem SPK - PAM Tirta Group</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        :root { 
            --primary: #0ea5e9; --primary-dark: #0284c7; --primary-light: #e0f2fe;
            --dark: #0f172a; --gray: #64748b; --bg: #f1f5f9; --sidebar-w: 280px; 
        }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--bg); color: var(--dark); overflow-x: hidden; }
        #sidebar { width: var(--sidebar-w); height: 100vh; position: fixed; top:0; left:0; background: #ffffff; border-right: 1px solid #e2e8f0; transition: 0.3s; z-index: 1000; padding-top: 25px; }
        .sidebar-brand { padding: 0 30px 30px; font-size: 1.25rem; font-weight: 800; color: var(--primary-dark); display: flex; align-items: center; gap: 12px; }
        .nav-link { padding: 12px 20px; color: var(--gray); font-weight: 600; border-radius: 12px; display: flex; align-items: center; text-decoration: none; margin-bottom: 4px; }
        .nav-link:hover, .nav-link.active { background: var(--primary-light); color: var(--primary-dark); }
        #content { margin-left: var(--sidebar-w); padding: 40px; transition: 0.3s; min-height: 100vh; }
        .card-modern { background: #fff; border: none; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.03); margin-bottom: 30px; overflow: hidden; }
        .card-header-modern { padding: 25px 30px; border-bottom: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center; font-weight: 700; font-size: 1.1rem; background: #fff; }
        .card-body-modern { padding: 0; }
        .btn-modern { background: var(--primary); color: #fff; border: none; padding: 10px 24px; border-radius: 10px; font-weight: 600; }
        .table-custom tbody td { padding: 16px 20px; vertical-align: middle; border-bottom: 1px solid #f1f5f9; }
        .table-custom thead th { background: #f8fafc; color: var(--gray); text-transform: uppercase; font-size: 0.75rem; padding: 18px 20px; border-bottom: 2px solid #e2e8f0; }
        .dataTables_wrapper .row:first-child { padding: 20px 25px; border-bottom: 1px solid #f1f5f9; }
        .dataTables_wrapper .row:last-child { padding: 20px 25px; border-top: 1px solid #f1f5f9; }
        .dataTables_length select { background-image: none !important; padding-right: 24px !important; }
        .login-bg { background: linear-gradient(135deg, #e0f2fe, #fff); height: 100vh; display: flex; align-items: center; justify-content: center; }
        @media(max-width:991px){ #sidebar{margin-left: calc(var(--sidebar-w)*-1);} #sidebar.active{margin-left:0;} #content{margin-left:0; padding: 20px;} }
        @media print { #sidebar, .no-print { display: none !important; } #content { margin: 0; padding: 0; } .card-modern { box-shadow: none; border: 1px solid #ddd; } }
    </style>
</head>
<body>

<% if(page === 'login') { %>
    <div class="login-bg">
        <div class="card-modern p-5 text-center" style="width: 450px;">
            <div class="mb-4 d-inline-block bg-info bg-opacity-10 p-4 rounded-4 text-info"><i class="fas fa-droplet fa-3x"></i></div>
            <h4 class="fw-bold mb-1">PAM TIRTA GROUP</h4>
            <p class="text-muted small mb-4">Sistem Penilaian Kinerja Karyawan</p>
            <% if(error){ %><div class="alert alert-danger py-2 small rounded-3 mb-4"><%= error %></div><% } %>
            <form method="POST" action="/login">
                <div class="form-floating mb-3"><input name="username" class="form-control" id="u" placeholder="u" required><label>Username</label></div>
                <div class="form-floating mb-4"><input type="password" name="password" class="form-control" id="p" placeholder="p" required><label>Password</label></div>
                <button class="btn btn-modern w-100 py-3">MASUK DASHBOARD</button>
            </form>
        </div>
    </div>
<% } else { %>

<div class="wrapper">
    <nav id="sidebar">
        <div class="sidebar-brand"><i class="fas fa-water text-primary"></i> PAM TIRTA GROUP</div>
        <div class="nav-section"><a href="/dashboard" class="nav-link <%= page=='dashboard'?'active':'' %>"><i class="fas fa-chart-pie"></i> Dashboard</a></div>
        <div class="nav-title">Master Data</div>
        <div class="nav-section">
            <a href="/kriteria" class="nav-link <%= page=='kriteria'?'active':'' %>"><i class="fas fa-list-check"></i> Data Kriteria</a>
            <a href="/karyawan" class="nav-link <%= page=='karyawan'?'active':'' %>"><i class="fas fa-users-gear"></i> Data Pegawai</a>
        </div>
        <div class="nav-section border-top pt-4"><a href="/analisis" class="nav-link <%= page=='analisis'?'active':'' %>"><i class="fas fa-award"></i> Hasil Penilaian</a></div>
        <div class="nav-section"><a href="/logout" class="nav-link text-danger"><i class="fas fa-sign-out-alt"></i> Keluar</a></div>
    </nav>

    <div id="content">
        <div class="d-flex justify-content-between align-items-center mb-5 no-print">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-light d-lg-none border" onclick="document.getElementById('sidebar').classList.toggle('active')"><i class="fas fa-bars"></i></button>
                <div><h3 class="fw-bold m-0"><%= page=='dashboard'?'Overview':(page=='kriteria'?'Master Kriteria':(page=='karyawan'?'Data Pegawai':'Hasil Keputusan')) %></h3></div>
            </div>
            <div class="bg-white border rounded-pill px-3 py-2 d-flex align-items-center gap-3 shadow-sm">
                <div class="text-end lh-1"><div class="fw-bold small"><%= user.nama_lengkap %></div><small class="text-muted" style="font-size:10px">Administrator</small></div>
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width:35px;height:35px">A</div>
            </div>
        </div>

        <% if(page === 'dashboard') { %>
            <div class="row g-4">
                <div class="col-md-4"><div class="card-modern p-4 d-flex align-items-center"><div class="bg-primary bg-opacity-10 text-primary p-4 rounded-4 me-4"><i class="fas fa-users fa-2x"></i></div><div><h6 class="text-muted fw-bold small">Total Pegawai</h6><h2 class="m-0 fw-bold"><%= c_k %></h2></div></div></div>
                <div class="col-md-4"><div class="card-modern p-4 d-flex align-items-center"><div class="bg-info bg-opacity-10 text-info p-4 rounded-4 me-4"><i class="fas fa-clipboard-list fa-2x"></i></div><div><h6 class="text-muted fw-bold small">Total Kriteria</h6><h2 class="m-0 fw-bold"><%= c_c %></h2></div></div></div>
                <div class="col-md-12"><div class="card-modern p-5 text-white position-relative overflow-hidden" style="background: linear-gradient(135deg, #0ea5e9, #0369a1);"><h2 class="fw-bold mb-3">Selamat Datang</h2><p>Sistem Penilaian Kehadiran Karyawan (SAW)</p><a href="/analisis" class="btn btn-light text-primary fw-bold shadow-sm">Lihat Ranking</a></div></div>
            </div>
        <% } else if(page === 'kriteria') { %>
            <div class="card-modern">
                <div class="card-header-modern">
                    <div class="d-flex align-items-center gap-3"><span class="bg-primary text-white rounded p-2"><i class="fas fa-sliders"></i></span> Data Kriteria</div>
                    <div><button class="btn btn-danger btn-sm d-none" id="bdk" onclick="submitBulk('formKriteria', '/del_kriteria')">Hapus</button> <button class="btn btn-modern btn-sm" onclick="modKriteria()">+ Baru</button></div>
                </div>
                <div class="card-body-modern">
                    <form id="formKriteria" method="POST" action="/del_kriteria"><div class="table-responsive"><table class="table table-custom table-hover mb-0" id="tk">
                        <thead><tr><th class="text-center no-sort"><input class="form-check-input" type="checkbox" onchange="toggleAll(this,'ck')"></th><th class="text-center">No</th><th>Kode</th><th>Nama</th><th>Atribut</th><th class="text-center">Bobot</th><th class="text-end no-sort">Aksi</th></tr></thead>
                        <tbody><% kriteria.forEach((r,i) => { %> <tr>
                            <td class="text-center"><input class="form-check-input ck" type="checkbox" name="ids[]" value="<%= r.id %>" onchange="chk('bdk','ck')"></td>
                            <td class="text-center fw-bold"><%= i+1 %></td><td><span class="badge bg-light text-dark border"><%= r.kode %></span></td><td class="fw-bold"><%= r.nama %></td>
                            <td><span class="badge <%= r.atribut=='benefit'?'bg-success':'bg-danger'%> bg-opacity-75"><%= r.atribut %></span></td><td class="text-center"><%= r.bobot %></td>
                            <td class="text-end"><button type="button" onclick='modKriteria(<%- JSON.stringify(r) %>)' class="btn btn-sm btn-light border text-primary"><i class="fas fa-pen"></i></button> <a href="/del_kriteria?id=<%= r.id %>" class="btn btn-sm btn-light border text-danger" onclick="return confirm('Hapus?')"><i class="fas fa-trash"></i></a></td>
                        </tr> <% }) %></tbody>
                    </table></div></form>
                </div>
            </div>
        <% } else if(page === 'karyawan') { %>
            <div class="d-flex justify-content-end gap-2 mb-4 no-print">
                <button class="btn btn-white border text-primary fw-bold btn-sm shadow-sm" onclick="modImport()"><i class="fas fa-file-csv"></i> Import</button>
                <a href="/export_csv" class="btn btn-white border text-primary fw-bold btn-sm shadow-sm"><i class="fas fa-download"></i> Export</a>
                <button class="btn btn-modern btn-sm shadow-sm" onclick="modKaryawan()">+ Input Data</button>
            </div>
            <div class="card-modern">
                <div class="card-header-modern">
                    <div class="d-flex align-items-center gap-3"><span class="bg-warning text-white rounded p-2"><i class="fas fa-users-gear"></i></span> Data Pegawai</div>
                    <button class="btn btn-danger btn-sm d-none" id="bdka" onclick="submitBulk('formKaryawan', '/del_karyawan')">Hapus</button>
                </div>
                <div class="card-body-modern">
                    <form id="formKaryawan" method="POST" action="/del_karyawan"><div class="table-responsive"><table class="table table-custom table-hover mb-0" id="tka">
                        <thead><tr><th class="text-center no-sort"><input class="form-check-input" type="checkbox" onchange="toggleAll(this,'cka')"></th><th class="text-center">No</th><th>Nama</th><th>Jabatan</th>
                        <% kriteria.forEach(c=>{ %> <th class="text-center w-small"><%= c.kode %><br><span style="font-size:0.6rem;font-weight:normal"><%= c.nama %></span></th> <% }) %> <th class="text-end no-sort">Aksi</th></tr></thead>
                        <tbody><% karyawan.forEach((r,i) => { %> <tr>
                            <td class="text-center"><input class="form-check-input cka" type="checkbox" name="ids[]" value="<%= r.id %>" onchange="chk('bdka','cka')"></td>
                            <td class="text-center fw-bold"><%= i+1 %></td><td class="fw-bold"><%= r.nama %></td><td class="text-muted"><%= r.jabatan %></td>
                            <% kriteria.forEach(c=>{ %> <td class="text-center"><%= r.vals[c.id]||0 %></td> <% }) %>
                            <td class="text-end"><button type="button" onclick='modKaryawan(<%- JSON.stringify(r) %>,<%- JSON.stringify(r.vals) %>)' class="btn btn-sm btn-light border text-primary"><i class="fas fa-pen"></i></button> <a href="/del_karyawan?id=<%= r.id %>" class="btn btn-sm btn-light border text-danger" onclick="return confirm('Hapus?')"><i class="fas fa-trash"></i></a></td>
                        </tr> <% }) %></tbody>
                    </table></div></form>
                </div>
            </div>
        <% } else if(page === 'analisis') { %>
            <div class="card-modern">
                <div class="card-header-modern"><div class="d-flex align-items-center gap-3"><span class="bg-success text-white rounded p-2"><i class="fas fa-award"></i></span> Hasil Perankingan</div><button onclick="window.print()" class="btn btn-sm btn-outline-secondary no-print fw-bold">Print</button></div>
                <div class="card-body-modern"><div class="table-responsive"><table class="table table-custom table-striped mb-0" id="trank">
                    <thead><tr><th class="ps-4">Rank</th><th style="min-width:200px">Nama Pegawai</th><% kriteria.forEach(c=>{ %> <th class="text-center w-small"><%= c.kode %><br><span style="font-size:0.6rem;font-weight:normal"><%= c.nama %></span></th> <% }) %> <th class="text-end pe-4 text-success">Total (V)</th></tr></thead>
                    <tbody><% let no=1; hasil.forEach(h => { %> <tr><td class="ps-4 fw-bold">#<%= no++ %></td><td><div class="fw-bold"><%= h.nama %></div><small class="text-muted"><%= h.jabatan %></small></td><% kriteria.forEach(c=>{ %> <td class="text-center text-muted"><%= h.detail[c.kode] %></td> <% }) %> <td class="text-end pe-4 fw-bold text-success fs-5"><%= h.nilai.toFixed(4) %></td></tr> <% }) %></tbody>
                </table></div></div>
            </div>
            <div class="card-modern no-print"><div class="card-header-modern"><span>Statistik</span></div><div class="p-5 d-flex justify-content-center"><div style="width:400px; max-width:100%"><canvas id="myChart"></canvas></div></div></div>
            <script>
                new Chart(document.getElementById('myChart'), { type: 'pie', data: { labels: <%- JSON.stringify(hasil.slice(0,10).map(h=>h.nama)) %>, datasets: [{ data: <%- JSON.stringify(hasil.slice(0,10).map(h=>h.nilai)) %>, backgroundColor: ['#0ea5e9','#38bdf8','#7dd3fc','#0284c7','#0369a1'] }] } });
                $(document).ready(function(){ $('#trank').DataTable({ language: { search: "Cari:" } }); });
            </script>
        <% } %>
    </div>
</div>

<div class="modal fade" id="mk"><div class="modal-dialog"><form method="POST" action="/save_kriteria" class="modal-content border-0 shadow"><div class="modal-header border-0"><h5 class="fw-bold">Form Kriteria</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="id" id="kid"><div class="mb-3"><label class="small fw-bold">Kode</label><input name="kode" id="kk" class="form-control" required></div><div class="mb-3"><label class="small fw-bold">Nama</label><input name="nama" id="kn" class="form-control" required></div><div class="row"><div class="col-6"><label class="small fw-bold">Atribut</label><select name="atribut" id="ka" class="form-control"><option value="benefit">Benefit</option><option value="cost">Cost</option></select></div><div class="col-6"><label class="small fw-bold">Bobot</label><input type="number" step="0.1" name="bobot" id="kb" class="form-control" required></div></div></div><div class="modal-footer border-0"><button class="btn btn-modern w-100">Simpan</button></div></form></div></div>

<div class="modal fade" id="mka"><div class="modal-dialog"><form method="POST" action="/save_karyawan" class="modal-content border-0 shadow" id="formKaryawanModal"><div class="modal-header border-0"><h5 class="fw-bold">Form Pegawai</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="id" id="karid"><div class="mb-3"><label class="small fw-bold">Nama Lengkap</label><input name="nama" id="karn" class="form-control" required></div><div class="mb-4"><label class="small fw-bold">Jabatan</label><input name="jabatan" id="karj" class="form-control" required></div><div class="bg-light p-3 rounded"><h6 class="small fw-bold text-muted mb-3">Nilai Penilaian</h6><div class="row g-2"><% if(typeof kriteria!=='undefined'){ kriteria.forEach(c=>{ %> <div class="col-6"><label class="small fw-bold mb-1"><%= c.kode %> - <%= c.nama %></label><input type="number" step="0.01" name="nilai[<%= c.id %>]" id="val_<%= c.id %>" class="form-control form-control-sm" required></div> <% })} %></div></div></div><div class="modal-footer border-0"><button class="btn btn-modern w-100">Simpan</button></div></form></div></div>

<div class="modal fade" id="mimp"><div class="modal-dialog"><form method="POST" action="/import_csv" enctype="multipart/form-data" class="modal-content border-0 shadow"><div class="modal-header border-0"><h5 class="fw-bold">Import CSV</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="file" name="file_csv" class="form-control" required></div><div class="modal-footer border-0"><button class="btn btn-modern w-100">Upload</button></div></form></div></div>

<script>
    $(document).ready(function(){ 
        const dtConfig = { language: { search: "Cari:", lengthMenu: "Tampil _MENU_", info: "_START_ - _END_ dari _TOTAL_" }, columnDefs: [ { orderable: false, targets: 0 } ] };
        $('#tk').DataTable(dtConfig); $('#tka').DataTable(dtConfig); 
    });

    // FUNGSI MODAL KRITERIA (RESET DULU BARU ISI)
    function modKriteria(d=null){ 
        $('#formKriteria')[0]?.reset(); // Reset form jika ada
        $('#kid').val(d?d.id:''); 
        $('#kk').val(d?d.kode:''); 
        $('#kn').val(d?d.nama:''); 
        $('#ka').val(d?d.atribut:'benefit'); 
        $('#kb').val(d?d.bobot:''); 
        new bootstrap.Modal('#mk').show(); 
    }

    // FUNGSI MODAL KARYAWAN (FIX RESET & POPULATE)
    function modKaryawan(d=null, v=null){ 
        // 1. Reset Total Form
        document.getElementById('formKaryawanModal').reset();
        $('#karid').val(''); // Pastikan ID kosong dulu
        
        // 2. Jika Mode Edit (Ada data 'd')
        if(d) {
            $('#karid').val(d.id); 
            $('#karn').val(d.nama); 
            $('#karj').val(d.jabatan); 
            // 3. Isi Nilai Loop
            if(v) for(let[i,x] of Object.entries(v)) {
                $('#val_'+i).val(x);
            }
        }
        
        // 4. Tampilkan Modal
        new bootstrap.Modal('#mka').show(); 
    }

    function modImport(){ new bootstrap.Modal('#mimp').show(); }
    function toggleAll(src,cls){ $('.'+cls).prop('checked',src.checked); chk(cls=='ck'?'bdk':'bdka',cls); }
    function chk(btn,cls){ $('.'+cls+':checked').length?$('#'+btn).removeClass('d-none'):$('#'+btn).addClass('d-none'); }
    function submitBulk(formId, actionUrl) { if(confirm('Hapus data terpilih?')) { document.getElementById(formId).action=actionUrl; document.getElementById(formId).submit(); } }
</script>
<% } %>
</body>
</html>
