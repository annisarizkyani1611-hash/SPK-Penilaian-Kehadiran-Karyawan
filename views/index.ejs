<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem SPK Karyawan</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

    <style>
        /* FIX LAYOUT: Header tabel satu baris (tidak turun) */
        table.dataTable thead th, table.dataTable tbody td {
            white-space: nowrap;
            vertical-align: middle;
        }

        /* FIX CSS: Mempercantik Card */
        .card {
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }
    </style>
</head>

<body class="bg-light">

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4 shadow px-4">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="#">SPK Penilaian Karyawan</a>
            
            <div class="ms-auto">
                <button class="btn btn-warning btn-sm fw-bold" data-bs-toggle="modal" data-bs-target="#loginModal">
                    <i class="fas fa-sign-in-alt"></i> Login Admin
                </button>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        
        <div class="card shadow mb-4">
            <div class="card-header py-3 bg-white">
                <h6 class="m-0 font-weight-bold text-primary">Data Ranking Karyawan</h6>
            </div>
            
            <div class="card-body p-4">
                
                <div class="table-responsive">
                    <table class="table table-bordered table-striped" id="tabelSPK" width="100%">
                        <thead class="table-dark">
                            <tr>
                                <th>No</th>
                                <th>Nama Karyawan</th>
                                <th>Jabatan</th>
                                <th>Keterangan / Alamat (Tes Scroll)</th>
                                <th>Nilai Akhir</th>
                                <th>Ranking</th>
                                <th>Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (typeof users !== 'undefined' && users.length > 0) { %>
                                <% users.forEach((user, index) => { %>
                                <tr>
                                    <td><%= index + 1 %></td>
                                    <td><%= user.nama %></td>
                                    <td><%= user.jabatan %></td>
                                    <td><%= user.alamat || 'Tidak ada data alamat yang diisi untuk karyawan ini...' %></td>
                                    <td><%= parseFloat(user.nilai_akhir).toFixed(2) %></td>
                                    
                                    <td data-order="<%= user.ranking %>">
                                        <% if(user.ranking == 1) { %>
                                            <span class="badge bg-warning text-dark"><i class="fas fa-trophy"></i> Juara 1</span>
                                        <% } else if(user.ranking == 2) { %>
                                            <span class="badge bg-secondary"><i class="fas fa-medal"></i> Juara 2</span>
                                        <% } else if(user.ranking == 3) { %>
                                            <span class="badge bg-danger"><i class="fas fa-medal"></i> Juara 3</span>
                                        <% } else { %>
                                            Peringkat <%= user.ranking %>
                                        <% } %>
                                    </td>
                                    
                                    <td>
                                        <button class="btn btn-info btn-sm"><i class="fas fa-edit"></i></button>
                                        <button class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></button>
                                    </td>
                                </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td>1</td>
                                    <td>Budi Santoso</td>
                                    <td>IT Staff</td>
                                    <td>Jl. Jendral Sudirman No. Kav 50, Jakarta Selatan (Teks Panjang...)</td>
                                    <td>95.50</td>
                                    <td data-order="1"><span class="badge bg-warning text-dark">🥇 Juara 1</span></td>
                                    <td>...</td>
                                </tr>
                                <tr>
                                    <td>2</td>
                                    <td>Ahmad Dhani</td>
                                    <td>HRD</td>
                                    <td>Jl. Pondok Indah Raya No. 10, Jakarta Selatan (Teks Panjang...)</td>
                                    <td>80.00</td>
                                    <td data-order="10">Peringkat 10</td>
                                    <td>...</td>
                                </tr>
                                <tr>
                                    <td>3</td>
                                    <td>Siti Nurhaliza</td>
                                    <td>Marketing</td>
                                    <td>Jl. Melawai Raya No. 20, Blok M, Jakarta Selatan (Teks Panjang...)</td>
                                    <td>90.00</td>
                                    <td data-order="2"><span class="badge bg-secondary">🥈 Juara 2</span></td>
                                    <td>...</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div> </div>
        </div>
    </div>

    <div class="modal fade" id="loginModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Login Administrator</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form action="/login" method="POST">
                        <div class="mb-3">
                            <label class="form-label">Username</label>
                            <input type="text" class="form-control" name="username" placeholder="admin">
                        </div>
                        
                        <label class="form-label">Password</label>
                        <div class="input-group mb-3">
                            <input type="password" class="form-control" id="inputPassword" name="password" placeholder="Masukkan password">
                            
                            <button class="btn btn-outline-secondary" type="button" id="togglePasswordBtn">
                                <i class="fas fa-eye" id="iconMata"></i>
                            </button>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Masuk</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function() {
            // 1. Inisialisasi DataTables
            $('#tabelSPK').DataTable({
                "ordering": true,
                "language": {
                    "search": "Cari Data:",
                    "lengthMenu": "Tampil _MENU_ baris",
                    "info": "Menampilkan _START_ sampai _END_ dari _TOTAL_ data"
                }
            });

            // 2. Logic Show/Hide Password (Javascript Murni)
            const toggleBtn = document.getElementById('togglePasswordBtn');
            const passInput = document.getElementById('inputPassword');
            const icon = document.getElementById('iconMata');

            if(toggleBtn) {
                toggleBtn.addEventListener('click', function() {
                    // Cek tipe apakah password atau text
                    const type = passInput.getAttribute('type') === 'password' ? 'text' : 'password';
                    passInput.setAttribute('type', type);

                    // Ubah ikon mata
                    if (type === 'text') {
                        icon.classList.remove('fa-eye');
                        icon.classList.add('fa-eye-slash'); // Mata dicoret
                    } else {
                        icon.classList.remove('fa-eye-slash');
                        icon.classList.add('fa-eye'); // Mata biasa
                    }
                });
            }
        });
    </script>

</body>
</html>
