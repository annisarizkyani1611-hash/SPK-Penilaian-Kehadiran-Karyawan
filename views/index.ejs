<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Data User</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* Agar teks tabel tidak turun ke bawah (wrap) saat layar kecil, memaksa scroll muncul */
        table.dataTable td, table.dataTable th {
            white-space: nowrap;
        }
        
        /* Styling tambahan untuk Card */
        .card {
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            border: none;
            border-radius: 10px;
        }
    </style>
</head>
<body class="bg-light">

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
        <div class="container">
            <a class="navbar-brand" href="#">Aplikasi Saya</a>
            <div class="d-flex">
                <button class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#loginModal">
                    <i class="fas fa-sign-in-alt"></i> Simulasi Login
                </button>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="card">
            <div class="card-header bg-white py-3">
                <h5 class="m-0 font-weight-bold text-primary">Data Pengguna</h5>
            </div>
            <div class="card-body">
                
                <div class="table-responsive">
                    <table id="tabelUser" class="table table-striped table-bordered" style="width:100%">
                        <thead class="table-dark">
                            <tr>
                                <th>No</th>
                                <th>Nama Lengkap</th>
                                <th>Email</th>
                                <th>Jabatan</th>
                                <th>Alamat Lengkap (Data Panjang)</th>
                                <th>Tanggal Bergabung</th>
                                <th>Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>1</td>
                                <td>Andi Saputra</td>
                                <td>andi@example.com</td>
                                <td>Manager IT</td>
                                <td>Jl. Sudirman No. 45, Jakarta Selatan, Gedung A Lantai 12 (Alamat ini sangat panjang sehingga memicu scroll)</td>
                                <td>2023-01-10</td>
                                <td>
                                    <button class="btn btn-sm btn-info"><i class="fas fa-edit"></i></button>
                                    <button class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td>2</td>
                                <td>Siti Aminah</td>
                                <td>siti@example.com</td>
                                <td>HRD Staff</td>
                                <td>Jl. Thamrin No. 10, Jakarta Pusat, Menara Bca (Alamat ini juga panjang sekali)</td>
                                <td>2023-02-15</td>
                                <td>
                                    <button class="btn btn-sm btn-info"><i class="fas fa-edit"></i></button>
                                    <button class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                                </td>
                            </tr>
                            </tbody>
                    </table>
                </div> </div>
        </div>
    </div>

    <div class="modal fade" id="loginModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Login Masuk</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form>
                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" placeholder="nama@email.com">
                        </div>
                        
                        <label for="password" class="form-label">Password</label>
                        <div class="input-group mb-3">
                            <input type="password" class="form-control" id="inputPassword" placeholder="Masukkan password">
                            
                            <button class="btn btn-outline-secondary" type="button" id="btnTogglePassword">
                                <i class="fas fa-eye" id="iconMata"></i>
                            </button>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Login</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>

    <script>
        // --- 1. INISIALISASI DATATABLES ---
        $(document).ready(function () {
            $('#tabelUser').DataTable({
                // Opsi ini memastikan search dan pagination rapi
                "language": {
                    "search": "Cari:",
                    "lengthMenu": "Tampil _MENU_ baris",
                    "info": "Menampilkan _START_ sampai _END_ dari _TOTAL_ data"
                }
            });
        });

        // --- 2. SCRIPT SHOW/HIDE PASSWORD ---
        const togglePassword = document.querySelector('#btnTogglePassword');
        const passwordInput = document.querySelector('#inputPassword');
        const iconMata = document.querySelector('#iconMata');

        togglePassword.addEventListener('click', function () {
            // Cek tipe input saat ini
            const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordInput.setAttribute('type', type);

            // Ubah Ikon (Mata terbuka / Mata dicoret)
            if (type === 'text') {
                iconMata.classList.remove('fa-eye');
                iconMata.classList.add('fa-eye-slash'); // Mata tertutup/slash
            } else {
                iconMata.classList.remove('fa-eye-slash');
                iconMata.classList.add('fa-eye'); // Mata biasa
            }
        });
    </script>

</body>
</html>
